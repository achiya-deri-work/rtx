recursive-include tests *.py
recursive-include tools *.py
# Match the private/chronological handoff exclusions in .gitignore. Explicit
# recursive includes otherwise pull ignored local files into an sdist.
exclude docs/afrl_*_202609*.md
exclude docs/mlp_*_202609*.md
exclude docs/mlp_deployment_goal_status.md
