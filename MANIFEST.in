include README.md
include PRECISION_POLICY.md
include LICENSE
include AUTOTUNING.md
include sm120_hardware.md
include CHANGELOG.md
include requirements.txt
include requirements-torch212-cu132.txt
include requirements-dev.txt
include requirements-first-hit.txt
recursive-include docs *.md
recursive-include docs/examples *.py
recursive-include autotune_manifests *.json
recursive-include autotune_manifests *.md
recursive-include benchmarks *.py
recursive-include benchmarks *.md
recursive-include benchmarks *.sh
